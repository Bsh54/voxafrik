# Copy to .env and adjust. Nothing here is required to run the classifier.

# Port the API listens on.
PORT=7070

# Where the AfriHate CSV splits live (default: ./data/afrihate).
# VOXAFRIK_DATA=data/afrihate

# Synthetic augmentation file added to training when present (default: ./augment.csv).
# VOXAFRIK_AUGMENT=augment.csv

# Directory served at "/" for the moderation console (default: ./frontend).
# VOXAFRIK_FRONTEND=frontend

# Optional translation service (OpenAI-compatible endpoint) used to show moderators
# an English version of a flagged post. Translation is skipped when this is unset.
# TRANSLATE_URL=https://your-endpoint.example/v1/chat/completions
# TRANSLATE_KEY=your-api-key
